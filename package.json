{
  "name": "path-cursor-pet",
  "displayName": "Patch Cursor Pet",
  "description": "Launch and set up Patch as a Cursor-aware desktop pet.",
  "version": "0.2.0",
  "publisher": "lasc",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/lasc/path-cursor-pet.git"
  },
  "homepage": "https://github.com/lasc/path-cursor-pet#readme",
  "bugs": {
    "url": "https://github.com/lasc/path-cursor-pet/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "pet",
    "duck",
    "muscovy",
    "codex"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "pathCursorPet.start",
        "title": "Start Desktop Patch",
        "category": "Patch Cursor Pet"
      },
      {
        "command": "pathCursorPet.import",
        "title": "Import or Update Patch",
        "category": "Patch Cursor Pet"
      },
      {
        "command": "pathCursorPet.setup",
        "title": "Open Setup Guide",
        "category": "Patch Cursor Pet"
      }
    ]
  },
  "scripts": {
    "test": "npm run build:pet && node --test",
    "build:pet": "node scripts/build-pet-package.mjs",
    "validate": "node scripts/validate-package.mjs",
    "package:vsix": "vsce package --out path-cursor-pet.vsix",
    "package": "npm run build:pet && npm run validate && npm run package:vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  }
}
